---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { company, type Lang } from '../../i18n/ui';
import { useTranslations, route } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const services = (await getCollection('services', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  lang={lang}
  title={t('nav.contact')}
  active="contact"
  description={t('contact.lead')}
>
  <PageHeader
    eyebrow={t('contact.eyebrow')}
    title={t('contact.title')}
    lead={t('contact.lead')}
  />

  <section class="contact">
    <div class="wrap contact-grid">
      <!-- ---------- form ---------- -->
      <form class="form" data-form novalidate>
        <div class="row">
          <div class="field">
            <label for="name">
              {t('contact.form.name')} <span class="req">*</span>
            </label>
            <input id="name" name="name" type="text" autocomplete="name" required />
            <p class="err" data-err-for="name" hidden></p>
          </div>

          <div class="field">
            <label for="email">
              {t('contact.form.email')} <span class="req">*</span>
            </label>
            <input id="email" name="email" type="email" autocomplete="email" required />
            <p class="err" data-err-for="email" hidden></p>
          </div>
        </div>

        <div class="row">
          <div class="field">
            <label for="phone">{t('contact.form.phone')}</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>

          <div class="field">
            <label for="service">{t('contact.form.service')}</label>
            <select id="service" name="service">
              <option value="">{t('contact.form.servicePlaceholder')}</option>
              {services.map((s) => <option value={s.data.key}>{s.data.title}</option>)}
              <option value="other">{t('contact.form.serviceOther')}</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="message">
            {t('contact.form.message')} <span class="req">*</span>
          </label>
          <textarea id="message" name="message" rows="6" required></textarea>
          <p class="hint">{t('contact.form.messageHint')}</p>
          <p class="err" data-err-for="message" hidden></p>
        </div>

        <!-- Honeypot. Real people never see or fill this. -->
        <div class="hp" aria-hidden="true">
          <label for="company-website">Website</label>
          <input id="company-website" name="company-website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>{t('contact.form.consent')} <a href={route(lang, 'privacy')}>{t('footer.privacy')}</a></span>
        </label>
        <p class="err" data-err-for="consent" hidden></p>

        <button class="btn form-submit" type="submit">
          <span data-submit-label>{t('contact.form.submit')}</span>
          <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <p class="form-msg" data-msg role="status" hidden></p>
      </form>

      <!-- ---------- details ---------- -->
      <aside class="details">
        <div class="det-block" data-reveal>
          <h2 class="label">{t('contact.direct')}</h2>
          <a class="det-big" href={`tel:${company.phoneHref}`}>{company.phone}</a>
          <a class="det-big" href={`mailto:${company.email}`}>{company.email}</a>
        </div>

        <div class="det-block" data-reveal style="--reveal-delay: 70ms">
          <h2 class="label">{t('contact.office')}</h2>
          <p class="det-text">
            {company.street}<br />
            {company.city}, {company.postalCode}<br />
            Latvija
          </p>
        </div>

        <div class="det-block" data-reveal style="--reveal-delay: 140ms">
          <h2 class="label">{t('contact.hours')}</h2>
          <p class="det-text">{t('contact.hoursValue')}</p>
        </div>

        <div class="det-block" data-reveal style="--reveal-delay: 210ms">
          <h2 class="label">{t('contact.details')}</h2>
          <p class="det-text det-mono">
            {company.legalName}<br />
            {company.regNr}
          </p>
        </div>

        <div class="map" data-reveal style="--reveal-delay: 260ms">
          <div class="map-ph">
            <span>{lang === 'lv' ? 'Kartes vieta' : 'Map slot'}</span>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { padding-bottom: clamp(4rem, 8vw, 7rem); }

  .contact-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 940px) {
    .contact-grid { grid-template-columns: 1.25fr 0.75fr; gap: 4.5rem; align-items: start; }
  }

  /* ---------- form ---------- */
  .form { display: grid; gap: 1.5rem; }

  .row { display: grid; gap: 1.5rem; }
  @media (min-width: 620px) { .row { grid-template-columns: 1fr 1fr; } }

  .field { display: grid; gap: 0.45rem; }

  label {
    font-family: var(--f-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .req { color: var(--accent-ink); }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    padding: 0.85em 1em;
    font-family: var(--f-body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--bg-elev);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  textarea { resize: vertical; min-height: 8rem; }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 22%, transparent);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] { border-color: #B4402F; }

  .hint {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .err {
    font-size: 0.82rem;
    color: #B4402F;
    font-weight: 500;
  }

  /* honeypot stays out of sight and out of the tab order */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    font-family: var(--f-body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .consent input { margin-top: 0.2rem; accent-color: var(--brand); width: 1rem; height: 1rem; }
  .consent a { color: var(--brand); }

  .form-submit { justify-self: start; margin-top: 0.5rem; }
  .form-submit .arrow { width: 18px; height: 18px; }
  .form-submit[disabled] { opacity: 0.6; cursor: progress; }

  .form-msg {
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    line-height: 1.55;
    border-left: 3px solid var(--accent);
    background: var(--brand-tint);
    color: var(--brand);
  }
  .form-msg[data-state='error'] {
    border-left-color: #B4402F;
    background: #FBEDEA;
    color: #7E2A1E;
  }

  /* ---------- details ---------- */
  .details { display: grid; gap: 2rem; }

  .det-block { padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .det-block h2 { margin-bottom: 0.8rem; }

  .det-big {
    display: block;
    font-family: var(--f-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--brand);
    text-decoration: none;
    margin-bottom: 0.3rem;
    transition: color 0.2s var(--ease-out);
  }
  .det-big:hover { color: var(--accent); }

  .det-text { font-size: var(--t-sm); line-height: 1.65; color: var(--ink-2); }
  .det-mono { font-family: var(--f-mono); font-size: 0.82rem; }

  .map-ph {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(0deg, var(--line) 0 1px, transparent 1px 32px),
      repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 32px),
      var(--bg-sunken);
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>

<script>
  /* ------------------------------------------------------------------
     Contact form.

     ENDPOINT is deliberately empty until the Cloudflare Pages Function
     is deployed (launch phase). While it is empty the form validates
     fully but tells the visitor to email directly instead of pretending
     to have sent something. Set the URL here and it starts posting.
     ------------------------------------------------------------------ */
  const ENDPOINT = '';

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const msg = document.querySelector<HTMLElement>('[data-msg]');
  const label = document.querySelector<HTMLElement>('[data-submit-label]');

  if (form && msg && label) {
    const lang = document.documentElement.lang.startsWith('lv') ? 'lv' : 'en';

    const text = {
      lv: {
        required: 'Šis lauks ir obligāts.',
        email: 'Lūdzu, ievadiet derīgu e-pasta adresi.',
        consent: 'Lai nosūtītu pieprasījumu, jāpiekrīt datu apstrādei.',
        sending: 'Sūta…',
        submit: 'Nosūtīt pieprasījumu',
        success: 'Paldies, pieprasījums saņemts. Atbildēsim tuvākajā darba dienā.',
        error: 'Neizdevās nosūtīt. Lūdzu, rakstiet tieši uz info@bmes.lv',
        notLive:
          'Forma vēl nav pieslēgta sūtīšanas servisam. Tas notiks publicēšanas brīdī. Pagaidām rakstiet uz info@bmes.lv vai zvaniet.',
      },
      en: {
        required: 'This field is required.',
        email: 'Please enter a valid email address.',
        consent: 'Please agree to your details being processed.',
        sending: 'Sending…',
        submit: 'Send enquiry',
        success: 'Thank you. We have your enquiry and will reply on the next working day.',
        error: 'Could not send. Please email info@bmes.lv directly.',
        notLive:
          'The form is not connected to a sending service yet. That happens at launch. For now, email info@bmes.lv or call us.',
      },
    }[lang];

    const showError = (name: string, message: string) => {
      const el = form.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLElement | null;
      if (el) { el.textContent = message; el.hidden = false; }
      input?.setAttribute('aria-invalid', 'true');
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('.err').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) =>
        el.removeAttribute('aria-invalid'),
      );
      msg.hidden = true;
      msg.removeAttribute('data-state');
    };

    const validate = () => {
      const data = new FormData(form);
      let ok = true;

      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      if (!name) { showError('name', text.required); ok = false; }
      if (!email) { showError('email', text.required); ok = false; }
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showError('email', text.email); ok = false;
      }
      if (!message) { showError('message', text.required); ok = false; }
      if (!data.get('consent')) { showError('consent', text.consent); ok = false; }

      return ok;
    };

    const say = (message: string, state?: 'error') => {
      msg.textContent = message;
      msg.hidden = false;
      if (state) msg.setAttribute('data-state', state);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      if (!validate()) {
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      const data = new FormData(form);

      // Honeypot tripped. Quietly behave as if it worked.
      if (String(data.get('company-website') ?? '')) {
        say(text.success);
        form.reset();
        return;
      }

      if (!ENDPOINT) {
        say(text.notLive, 'error');
        return;
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      btn?.setAttribute('disabled', '');
      label.textContent = text.sending;

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!res.ok) throw new Error(String(res.status));
        say(text.success);
        form.reset();
      } catch {
        say(text.error, 'error');
      } finally {
        btn?.removeAttribute('disabled');
        label.textContent = text.submit;
      }
    });
  }
</script>
