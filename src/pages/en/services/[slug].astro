---
import { getCollection } from 'astro:content';
import ServiceDetail from '../../../components/pages/ServiceDetail.astro';
import { serviceSlugs, type ServiceKey } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('services', (e) => e.data.lang === 'en');
  return entries.map((entry) => ({
    params: { slug: serviceSlugs[entry.data.key as ServiceKey].en },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ServiceDetail lang="en" entry={entry} />
